PORT=8080
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanrides?retryWrites=true&w=majority

# Better Auth: long random string that signs session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me
# The URL people open the site on. In development the Vite dev server proxies /api to this backend,
# so this is the frontend's address, not the backend's.
BETTER_AUTH_URL=http://localhost:3000

# Optional: Google sign-in. Leave blank to turn it off.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: DNS servers for resolving the Atlas SRV record (fixes querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional: comma-separated frontend URLs allowed to call the API and receive auth cookies
# CLIENT_ORIGINS=http://localhost:3000,https://urbanrides.vercel.app
